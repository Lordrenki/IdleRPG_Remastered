# Discord credentials
BOT_TOKEN=your_discord_bot_token
BOT_GLOBAL_PREFIX=$

# Default local development database credentials (used by docker-compose)
POSTGRES_DB=idlerpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis defaults for local development
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional: single connection string from managed Postgres providers (Neon, Supabase, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/database
# POSTGRES_URL can be used interchangeably with DATABASE_URL.

# Optional: managed Redis providers (Upstash, etc.)
# REDIS_URL=rediss://default:password@host:6379/0
# UPSTASH_REDIS_URL can be used interchangeably with REDIS_URL and REDIS_TLS_URL.

# Optional: channel used for shard announcements if redis pub/sub is enabled
# REDIS_SHARD_ANNOUNCE_CHANNEL=guild_channel
